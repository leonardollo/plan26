{
  "name": "plan-2026-app",
  "private": true,
  "version": "1.0.0",
  "description": "Planejamento Estratégico do ano seguinte - Gestão de Impacto",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode banco-local",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "supabase start",
    "db:local:semear": "node scripts/semear-local.mjs",
    "test:db": "supabase db reset --local && vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@google/genai": "^1.44.0",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.35.0",
    "jsdom": "^31.0.0",
    "supabase": "^3.1.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gestaoimpacto/app-orcamento-gi.git"
  }
}
