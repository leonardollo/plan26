{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(codex review *)",
      "Bash(codex login status *)",
      "Bash(claude -p --disallowedTools *)",
      "Bash(git symbolic-ref *)",
      "Bash(git push -u origin *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(npm ci *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run build *)",
      "Bash(npm audit *)",
      "Bash(npm test *)",
      "Bash(npm run test:rules *)",
      "Bash(npx vitest *)",
      "PowerShell(npm test *)",
      "PowerShell(npm run test:rules *)",
      "PowerShell(npx vitest *)",
      "PowerShell(npm ci *)",
      "PowerShell(npm run typecheck *)",
      "PowerShell(npm run build *)",
      "PowerShell(npm audit *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git switch *)",
      "PowerShell(git merge *)",
      "PowerShell(git stash *)",
      "PowerShell(git branch *)",
      "PowerShell(git worktree *)",
      "PowerShell(codex review *)",
      "PowerShell(codex login status *)",
      "PowerShell(claude -p --disallowedTools *)",
      "PowerShell(git symbolic-ref *)",
      "PowerShell(git push -u origin *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)"
    ],
    "ask": [
      "Bash(git push -f*)",
      "Bash(git push --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git worktree remove -f*)",
      "Bash(git worktree remove --force*)",
      "Bash(git push *main*)",
      "Bash(gh pr merge *)",
      "Bash(firebase deploy *)",
      "Bash(npx firebase deploy *)",
      "PowerShell(firebase deploy *)",
      "PowerShell(npx firebase deploy *)",
      "PowerShell(git push -f*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git worktree remove -f*)",
      "PowerShell(git worktree remove --force*)",
      "PowerShell(git push *main*)",
      "PowerShell(gh pr merge *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)"
    ]
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "superpowers@claude-plugins-official": false,
    "superpowers@superpowers-marketplace": false
  },
  "worktree": {
    "baseRef": "head"
  }
}
