rules_version = '2';

// ============================================================
//  PLAN 2026 — regras de acesso ao Firestore
//
//  Cole no console: console.firebase.google.com/project/plan-ea4cc/firestore/rules
//  → colar tudo → Publicar.
//
//  A ideia em uma frase: quem se cadastra fica PENDENTE e não alcança dado
//  nenhum. Um administrador libera. Só depois de liberado a pessoa passa a
//  ler e escrever o próprio espaço — e nunca o dos outros.
//
//  Isto aqui é o que realmente barra. A tela do app pode ser burlada por
//  qualquer um com o navegador aberto; a regra do banco, não.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador é quem tem um documento em `admins` cujo ID é o e-mail.
    // Pelo e-mail e não pelo uid: assim dá para cadastrar alguém antes mesmo
    // dessa pessoa ter conta.
    // Sem e-mail verificado, quem cria conta com o e-mail de um admin sem conta ganharia o poder.
    function souAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    function meuAcessoEsta(status) {
      return request.auth != null
        && exists(/databases/$(database)/documents/acessos/$(request.auth.uid))
        && get(/databases/$(database)/documents/acessos/$(request.auth.uid)).data.status == status;
    }

    // ---------- quem é administrador ----------
    // Cada pessoa logada só confere o documento do PRÓPRIO e-mail, para saber
    // se é admin; ninguém lista a coleção, para não expor quem administra.
    // Ninguém escreve pelo app: administrador se cadastra no console, à mão.
    // É isso que impede alguém se promover sozinho.
    match /admins/{email} {
      allow get: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // ---------- a fila de liberação ----------
    match /acessos/{uid} {
      // vejo o meu; o administrador vê todos
      allow get: if request.auth != null && (request.auth.uid == uid || souAdmin());
      allow list: if souAdmin();

      // a pessoa cria o próprio pedido, e SÓ como pendente.
      // Sem esta checagem de status, bastaria abrir o console do navegador e
      // criar o próprio documento já liberado.
      // O guarda de e-mail nulo importa: sem ele, uma conta sem e-mail faria a
      // regra estourar em vez de simplesmente recusar.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email != null
        && request.resource.data.status == 'pendente'
        && request.resource.data.email == request.auth.token.email.lower()
        // Campo opcional: o bundle antigo ainda aberto não o envia.
        && (!('emailVerificado' in request.resource.data)
          || request.resource.data.emailVerificado == request.auth.token.email_verified);

      // mudar status é só do administrador
      allow update: if souAdmin();

      // ninguém apaga: a fila é histórico de quem pediu acesso e quando
      allow delete: if false;
    }

    // ---------- os dados de planejamento ----------
    // O espaço de cada pessoa. Duas condições, as duas obrigatórias:
    // ser dona do espaço, e estar com o acesso liberado.
    // O administrador NÃO entra na fila — ele é quem libera os outros. Sem o
    // `souAdmin()` aqui, quem administra ficava sem poder salvar o próprio
    // planejamento: a regra exigia um documento em `acessos` que administrador
    // nenhum chega a ter. Repare que `request.auth.uid == uid` continua em pé:
    // ser administrador dá acesso ao PRÓPRIO espaço, nunca ao dos outros.
    function podeUsarOEspaco() {
      return meuAcessoEsta('liberado') || souAdmin();
    }

    match /users/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && podeUsarOEspaco();

      // Um plano por ano. O 2026 mora no próprio users/{uid} (ANO_DO_PLANO_LEGADO
      // em src/services/planos.ts); aqui ficam 2027 em diante, até o ano
      // seguinte ao atual (o app só começa um ano à frente). Sem isso, o cliente
      // gravava `planos/9999` e o seletor de ano passava a oferecer 9999.
      // Ler e apagar não olham o ano: a listagem dos planos precisa ver tudo.
      function anoDePlanoValido(ano) {
        return ano.matches('^[0-9]{4}$')
          && int(ano) > 2026
          && int(ano) <= request.time.year() + 1;
      }

      match /planos/{ano} {
        allow read, delete: if request.auth != null
          && request.auth.uid == uid
          && podeUsarOEspaco();
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && podeUsarOEspaco()
          && anoDePlanoValido(ano);
      }

      // Outras subcoleções: só leitura do dono. O app não grava nenhuma, e
      // gravar aqui também liberaria `planos/{ano}` sem a checagem do ano.
      match /{documento=**} {
        allow read: if request.auth != null
          && request.auth.uid == uid
          && podeUsarOEspaco();
      }
    }

    // ---------- tudo o mais ----------
    // Coleção que não foi pensada aqui não é liberada por engano.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
