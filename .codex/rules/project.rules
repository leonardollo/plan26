# Project commands verified by /onboard (PLAN 2026).

prefix_rule(pattern = ["npm", "ci"], decision = "allow", justification = "Install from the lockfile (network)")
prefix_rule(pattern = ["npm", "run", "typecheck"], decision = "allow", justification = "Typecheck")
prefix_rule(pattern = ["npm", "run", "build"], decision = "allow", justification = "Typecheck + production build")
prefix_rule(pattern = ["npm", "audit"], decision = "allow", justification = "Dependency audit (network)")
prefix_rule(pattern = ["npm", "test"], decision = "allow", justification = "App tests (Vitest)")
prefix_rule(pattern = ["npm", "run", "test:rules"], decision = "allow", justification = "Firestore rules tests in the local emulator (demo-plan)")
prefix_rule(pattern = ["npx", "vitest"], decision = "allow", justification = "Affected app tests")

# Production: publishes Firestore rules or deploys to Firebase.
prefix_rule(pattern = ["firebase", "deploy"], decision = "prompt", justification = "Writes to production Firebase")
prefix_rule(pattern = ["npx", "firebase", "deploy"], decision = "prompt", justification = "Writes to production Firebase")
